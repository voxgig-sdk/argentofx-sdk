# Entity: currency

main: kit: entity: currency: {

  alias: field: {}

  fields: [
    {
      name: "compra"
      req: true
      type: "`$NUMBER`"
    }
    {
      name: "fechaActualizacion"
      req: true
      type: "`$STRING`"
    }
    {
      name: "moneda"
      req: true
      type: "`$STRING`"
    }
    {
      name: "nombre"
      req: true
      type: "`$STRING`"
    }
    {
      name: "venta"
      req: true
      type: "`$NUMBER`"
    }
  ]

  name: "currency"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/currencies"
          parts: [
            "currencies"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "EUR"
                kind: "param"
                name: "id"
                orig: "currency"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/currencies/{currency}"
          parts: [
            "currencies"
            "{id}"
          ]
          rename: {
            param: {
              currency: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
