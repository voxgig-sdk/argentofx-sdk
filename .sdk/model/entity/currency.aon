# Entity: currency

main: kit: entity: currency: {

  alias: field: {}

  fields: [
    {
      format: "float"
      name: "compra"
      req: true
      short: "Buy price"
      type: "`$NUMBER`"
    }
    {
      format: "date-time"
      name: "fechaActualizacion"
      req: true
      short: "Last update timestamp"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "moneda"
      req: true
      short: "Currency code"
      type: "`$STRING`"
    }
    {
      name: "nombre"
      req: true
      short: "Currency name"
      type: "`$STRING`"
    }
    {
      format: "float"
      name: "venta"
      req: true
      short: "Sell price"
      type: "`$NUMBER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "currency"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/currencies"
          segments: [
            {
              lit: "currencies"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "EUR"
                kind: "param"
                name: "id"
                orig: "currency"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/currencies/{currency}"
          rename: {
            param: {
              currency: "id"
            }
          }
          segments: [
            {
              lit: "currencies"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
