# Entity: currency

main: kit: entity: currency: {

  alias: field: {}

  fields: [
    {
      format: "float"
      name: "compra"
      req: true
      short: "Buy price"
      type: "`$NUMBER`"
    }
    {
      format: "date-time"
      name: "fechaActualizacion"
      req: true
      short: "Last update timestamp"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "moneda"
      req: true
      short: "Currency code"
      type: "`$STRING`"
    }
    {
      name: "nombre"
      req: true
      short: "Currency name"
      type: "`$STRING`"
    }
    {
      format: "float"
      name: "venta"
      req: true
      short: "Sell price"
      type: "`$NUMBER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "currency"
  op: {
    list: {
      name: "list"
      points: [
        {
          contract: {
            id: "GET /currencies"
            json: "{\"operationId\":\"getAllCurrencies\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"items\":{\"properties\":{\"compra\":{\"description\":\"Buy price\",\"example\":395.25,\"format\":\"float\",\"type\":\"number\"},\"fechaActualizacion\":{\"description\":\"Last update timestamp\",\"example\":\"2024-01-15T10:30:00Z\",\"format\":\"date-time\",\"type\":\"string\"},\"moneda\":{\"description\":\"Currency code\",\"example\":\"EUR\",\"type\":\"string\"},\"nombre\":{\"description\":\"Currency name\",\"example\":\"Euro\",\"type\":\"string\"},\"venta\":{\"description\":\"Sell price\",\"example\":415.75,\"format\":\"float\",\"type\":\"number\"}},\"required\":[\"moneda\",\"nombre\",\"compra\",\"venta\",\"fechaActualizacion\"],\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"Successful response with all currency quotations\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"detail\":{\"description\":\"Error message\",\"example\":\"Resource not found\",\"type\":\"string\"}},\"required\":[\"detail\"],\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/currencies"
          segments: [
            {
              lit: "currencies"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "EUR"
                kind: "param"
                name: "id"
                orig: "currency"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /currencies/{currency}"
            json: "{\"operationId\":\"getCurrencyQuote\",\"parameters\":[{\"description\":\"Currency code (e.g., EUR, BRL, CLP, UYU)\",\"in\":\"path\",\"name\":\"currency\",\"required\":true,\"schema\":{\"example\":\"EUR\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"compra\":{\"description\":\"Buy price\",\"example\":395.25,\"format\":\"float\",\"type\":\"number\"},\"fechaActualizacion\":{\"description\":\"Last update timestamp\",\"example\":\"2024-01-15T10:30:00Z\",\"format\":\"date-time\",\"type\":\"string\"},\"moneda\":{\"description\":\"Currency code\",\"example\":\"EUR\",\"type\":\"string\"},\"nombre\":{\"description\":\"Currency name\",\"example\":\"Euro\",\"type\":\"string\"},\"venta\":{\"description\":\"Sell price\",\"example\":415.75,\"format\":\"float\",\"type\":\"number\"}},\"required\":[\"moneda\",\"nombre\",\"compra\",\"venta\",\"fechaActualizacion\"],\"type\":\"object\"}}},\"description\":\"Successful response with specific currency quotation\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"detail\":{\"description\":\"Error message\",\"example\":\"Resource not found\",\"type\":\"string\"}},\"required\":[\"detail\"],\"type\":\"object\"}}},\"description\":\"Currency not found\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"detail\":{\"description\":\"Error message\",\"example\":\"Resource not found\",\"type\":\"string\"}},\"required\":[\"detail\"],\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/currencies/{currency}"
          rename: {
            param: {
              currency: "id"
            }
          }
          segments: [
            {
              lit: "currencies"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



